rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own links; anyone can read public links
    match /users/{userId}/links/{linkId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || resource.data.isPublic == true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User profile doc and usernames mapping
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
